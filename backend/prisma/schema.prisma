generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  ADMIN
  MEMBER
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum AccessLevel {
  READ_ONLY
  READ_WRITE
}

enum AccessRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ReportStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

enum FileStatus {
  ACTIVE
  ORPHANED
  DELETED
  UNREGISTERED
}

enum NodeType {
  FOLDER
  FILE
}

enum ReportCategory {
  SPECIAL_OPERATIONS
  ANOMALY
  STUDY
  DAILY_REPORT
  OTHER
}

// ============================================================
// USER
// ============================================================

model User {
  id           String  @id @default(uuid())
  name         String
  email        String  @unique
  employeeId   String? @unique
  passwordHash String?

  role   UserRole   @default(MEMBER)
  status UserStatus @default(PENDING)

  lastLogin DateTime?
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Department access granted by admin
  departmentAccess UserDepartmentAccess[]

  // Requests made by this member
  accessRequests ReportAccessRequest[] @relation("RequestedBy")

  // Requests processed by admin
  processedRequests ReportAccessRequest[] @relation("ProcessedBy")

  // Files uploaded by user
  uploadedFiles File[] @relation("FileUploader")

  // File versions uploaded by user
  uploadedVersions FileVersion[] @relation("VersionUploader")

  // Favorites
  favorites FileFavorite[]

  // File permissions
  filePermissions FilePermission[]

  // Notifications
  notifications Notification[]

  // Audit logs generated by user
  auditLogs AuditLog[]

  // Reports created by user
  createdReports Report[] @relation("ReportCreator")

  // Soft-deleted records
  deletedByAuditLogs AuditLog[] @relation("AuditDeletedBy")

  // Refresh tokens / sessions
  refreshTokens RefreshToken[]
}

// ============================================================
// SATELLITE
// ============================================================

model Satellite {
  id          String  @id @default(uuid())
  name        String
  code        String? @unique
  description String?

  isActive Boolean @default(true)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  departments Department[]

  @@index([name])
  @@index([deletedAt])
}

// ============================================================
// DEPARTMENT
// ============================================================

model Department {
  id String @id @default(uuid())

  satelliteId String
  satellite   Satellite @relation(fields: [satelliteId], references: [id], onDelete: Restrict)

  name        String
  code        String?
  description String?

  // Physical root directory for this department
  hddPath String

  isActive Boolean @default(true)

  // Configuration
  allowUserFolderCreation Boolean @default(false)
  maxFolderDepth          Int     @default(5)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Files/folders belonging to department
  files File[]

  // Members who have access
  userAccess UserDepartmentAccess[]

  // Access requests
  accessRequests ReportAccessRequest[]

  // Reports
  reports Report[]

  @@unique([satelliteId, name])
  @@index([satelliteId])
  @@index([isActive])
  @@index([deletedAt])
}

// ============================================================
// USER ↔ DEPARTMENT ACCESS
// ============================================================

model UserDepartmentAccess {
  id String @id @default(uuid())

  userId       String
  departmentId String

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  accessLevel AccessLevel @default(READ_ONLY)

  grantedAt DateTime  @default(now())
  expiresAt DateTime?

  deletedAt DateTime?

  @@unique([userId, departmentId])
  @@index([userId])
  @@index([departmentId])
  @@index([deletedAt])
}

// ============================================================
// REPORT
// ============================================================
//
// A REPORT is a logical entity/record, NOT merely a folder.
//
// Its actual document(s) are represented by File/FileVersion.
// This allows one report to have metadata + one or more files.
//

model Report {
  id String @id @default(uuid())

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  createdById String
  createdBy   User   @relation("ReportCreator", fields: [createdById], references: [id], onDelete: Restrict)

  title       String
  description String?

  category ReportCategory?
  status   ReportStatus    @default(ACTIVE)

  reportNumber String?
  versionLabel String?

  // Report-specific metadata
  spacecraft          String?
  mission             String?
  classificationLevel String?
  customCategory      String?
  namingConvention    String?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  files          File[]
  accessRequests ReportAccessRequest[]

  @@index([departmentId])
  @@index([status])
  @@index([category])
  @@index([deletedAt])
}

// ============================================================
// REPORT ACCESS REQUEST
// ============================================================

model ReportAccessRequest {
  id String @id @default(uuid())

  requestedById String
  requestedBy   User   @relation("RequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  // Optional: member may request access to a particular report
  reportId String?
  report   Report? @relation(fields: [reportId], references: [id], onDelete: Restrict)

  requestedLevel AccessLevel @default(READ_ONLY)

  status AccessRequestStatus @default(PENDING)

  processedById String?
  processedBy   User?   @relation("ProcessedBy", fields: [processedById], references: [id], onDelete: SetNull)

  reason       String?
  adminComment String?

  requestedAt DateTime  @default(now())
  processedAt DateTime?

  deletedAt DateTime?

  @@index([requestedById])
  @@index([departmentId])
  @@index([reportId])
  @@index([status])
  @@index([deletedAt])
}

// ============================================================
// FILE / FOLDER TREE
// ============================================================

model File {
  id String @id @default(uuid())

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  // Optional report this file belongs to
  reportId String?
  report   Report? @relation(fields: [reportId], references: [id], onDelete: Restrict)

  // Parent folder
  parentId String?
  parent   File?   @relation("FileTree", fields: [parentId], references: [id], onDelete: SetNull)

  children File[] @relation("FileTree")

  nodeType NodeType

  name    String
  hddPath String

  sizeBytes BigInt?
  mimeType  String?
  extension String?
  sha256    String?

  status FileStatus @default(ACTIVE)

  description String?

  versionCount Int @default(1)

  uploaderId String
  uploader   User   @relation("FileUploader", fields: [uploaderId], references: [id], onDelete: Restrict)

  lastSynced DateTime?
  deletedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions    FileVersion[]
  favorites   FileFavorite[]
  permissions FilePermission[]
  shareLinks  FileShareLink[]
  tags        FileTag[]

  @@unique([hddPath])
  @@index([departmentId, status])
  @@index([reportId])
  @@index([parentId])
  @@index([uploaderId])
  @@index([deletedAt])
}

// ============================================================
// FILE VERSION
// ============================================================

model FileVersion {
  id String @id @default(uuid())

  fileId String
  file   File   @relation(fields: [fileId], references: [id], onDelete: Restrict)

  versionNum Int

  hddPath   String
  sizeBytes BigInt?
  sha256    String?

  uploadedBy String
  uploader   User   @relation("VersionUploader", fields: [uploadedBy], references: [id], onDelete: Restrict)

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@unique([fileId, versionNum])
  @@index([fileId])
  @@index([deletedAt])
}

// ============================================================
// FILE FAVORITE
// ============================================================

model FileFavorite {
  id String @id @default(uuid())

  userId String
  fileId String

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  file File @relation(fields: [fileId], references: [id], onDelete: Restrict)

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@unique([userId, fileId])
  @@index([fileId])
}

// ============================================================
// FILE PERMISSION
// ============================================================

model FilePermission {
  id String @id @default(uuid())

  fileId String
  userId String

  file File @relation(fields: [fileId], references: [id], onDelete: Restrict)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  access AccessLevel @default(READ_ONLY)

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@unique([fileId, userId])
  @@index([userId])
}

// ============================================================
// FILE SHARE LINK
// ============================================================

model FileShareLink {
  id String @id @default(uuid())

  fileId String
  file   File   @relation(fields: [fileId], references: [id], onDelete: Restrict)

  token     String   @unique
  expiresAt DateTime

  singleUse Boolean   @default(false)
  usedAt    DateTime?

  createdBy String
  createdAt DateTime @default(now())

  deletedAt DateTime?

  @@index([fileId])
}

// ============================================================
// TAG
// ============================================================

model Tag {
  id   String @id @default(uuid())
  name String @unique

  createdBy String
  createdAt DateTime @default(now())

  deletedAt DateTime?

  files FileTag[]

  @@index([deletedAt])
}

// ============================================================
// FILE ↔ TAG
// ============================================================

model FileTag {
  fileId String
  tagId  String

  file File @relation(fields: [fileId], references: [id], onDelete: Restrict)

  tag Tag @relation(fields: [tagId], references: [id], onDelete: Restrict)

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@id([fileId, tagId])
}

// ============================================================
// NOTIFICATION
// ============================================================

model Notification {
  id BigInt @id @default(autoincrement())

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  type    String
  actorId String?

  resourceType String?
  resourceId   String?

  message String

  metadata Json?

  category String

  readAt      DateTime?
  dismissedAt DateTime?

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@index([userId, readAt, createdAt])
  @@index([userId, type, createdAt])
}

// ============================================================
// AUDIT LOG
// ============================================================

model AuditLog {
  id BigInt @id @default(autoincrement())

  userId          String?
  deletedByUserId String?

  user      User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  deletedBy User? @relation("AuditDeletedBy", fields: [deletedByUserId], references: [id], onDelete: SetNull)

  action       String
  resourceType String?
  resourceId   String?

  oldValue Json?
  newValue Json?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([deletedByUserId])
  @@index([action, createdAt])
}

// ============================================================
// PASSWORD RESET
// ============================================================

model PasswordResetToken {
  id String @id @default(uuid())

  userId String

  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())
}

// ============================================================
// REFRESH TOKEN / SESSION
// ============================================================
//
// Do NOT store the raw refresh token.
// Store only its hash.
//

model RefreshToken {
  id String @id @default(uuid())

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  tokenHash String @unique

  revoked Boolean @default(false)

  expiresAt DateTime
  createdAt DateTime @default(now())

  revokedAt DateTime?

  @@index([userId])
  @@index([expiresAt])
}

// ============================================================
// CMS
// ============================================================

model CmsBlock {
  blockKey String @id
  content  Json

  updatedBy String?
  updatedAt DateTime @updatedAt

  deletedAt DateTime?
}

// ============================================================
// SYSTEM CONFIG
// ============================================================

model SystemConfig {
  configKey   String @id
  configValue String @db.LongText

  updatedBy String?
  updatedAt DateTime @default(now()) @updatedAt

  deletedAt DateTime?
}

// ============================================================
// REPORT PRESETS & NAMING CONVENTIONS
// ============================================================

model ReportCategoryPreset {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String   @unique
  description String?  @db.Text
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model NamingPreset {
  id          String   @id @default(uuid())
  name        String   @unique
  template    String   @db.Text
  description String?  @db.Text
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

