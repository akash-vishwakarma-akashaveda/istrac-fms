# ==============================================================================
# 🛰️ ISTRAC-SIMS — Production Environment Configuration Template (.env.example)
# Copy this file to .env and configure for your deployment:
# Ubuntu Linux:  chmod 600 /opt/istrac-sims/backend/.env
# Windows:       D:\istrac-sims\backend\.env
# ==============================================================================

NODE_ENV=production
PORT=3000
APP_URL=http://localhost

# Allowed CORS Origins (Comma-separated)
# Private RFC 1918 IPs (10.x, 172.16-31.x, 192.168.x) & localhost on any port are automatically permitted
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1

# Database Configuration (MariaDB / MySQL on Port 3306)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=istrac_sims
MYSQL_USER=istrac_user
MYSQL_PASSWORD=change-me
DATABASE_URL="mysql://istrac_user:change-me@127.0.0.1:3306/istrac_sims"

# Redis Cache & Event Bus (Port 6379)
# Note: If Redis is offline or not installed, the application automatically uses in-memory caching and scheduling
REDIS_URL="redis://127.0.0.1:6379"

# Cryptographic Security Secrets (Minimum 32 random characters)
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32
JWT_REFRESH_SECRET=change-me-generate-a-different-value

# Physical Telemetry & File Storage Path
# Ubuntu: HDD_MOUNT_PATH=/mnt/istrac_storage
# Windows: HDD_MOUNT_PATH=D:\istrac_storage
HDD_MOUNT_PATH=/mnt/istrac_storage

# Optional Internal SMTP Email Relay
ADMIN_EMAIL=admin@istrac.local
SMTP_HOST=localhost
SMTP_PORT=25
# SMTP_USER=
# SMTP_PASS=

# Reverse proxy trust for real client IPs (rate limits, audit). Default trusts only a proxy on
# this host (nginx/Apache on the same server). Set to the proxy IP if it runs elsewhere.
# TRUST_PROXY=loopback
