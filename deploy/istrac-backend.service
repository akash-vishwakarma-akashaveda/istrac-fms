[Unit]
Description=ISTRAC SIMS Backend API Server
After=network.target mysql.service
Wants=mysql.service

[Service]
Type=simple
User=istrac
Group=istrac
WorkingDirectory=/opt/istrac-sims/backend
ExecStart=/usr/bin/node dist/src/index.js
Restart=always
RestartSec=5
LimitNOFILE=65535
StandardOutput=journal
StandardError=journal
EnvironmentFile=/opt/istrac-sims/backend/.env

[Install]
WantedBy=multi-user.target
