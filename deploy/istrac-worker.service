[Unit]
Description=ISTRAC SIMS Mission Event Scheduler & Sync Worker
After=network.target mysql.service istrac-backend.service
Wants=mysql.service

[Service]
Type=simple
User=istrac
Group=istrac
WorkingDirectory=/opt/istrac-sims/backend
ExecStart=/usr/bin/node dist/src/worker.js
Restart=always
RestartSec=10
LimitNOFILE=65535
StandardOutput=journal
StandardError=journal
EnvironmentFile=/opt/istrac-sims/backend/.env

[Install]
WantedBy=multi-user.target
